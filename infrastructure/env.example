# Warehouse infrastructure — copy to .env and adjust locally.
# Never commit real secrets.

# Postgres
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse
POSTGRES_DB=warehouse
DATABASE_URL=postgres://warehouse:warehouse@localhost:5432/warehouse?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# App
TZ=Asia/Bangkok
NEXT_PUBLIC_API_URL=http://localhost:1323/api/v1
API_V1_PREFIX=/api/v1

# Gateway (nginx-ui)
NGINX_PORT=80
NGINX_UI_PORT=9000

# Dev admin (profile: dev)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
REDIS_COMMANDER_PORT=8081
