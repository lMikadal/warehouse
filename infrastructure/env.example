# Warehouse infrastructure — copy to .env and adjust locally.
# Never commit real secrets.

# Postgres
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse
POSTGRES_DB=warehouse
POSTGRES_PORT=5432
DATABASE_URL=postgres://warehouse:warehouse@localhost:5432/warehouse?sslmode=disable

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# App
TZ=Asia/Bangkok
# Frontend container (compose): must reach Go on the Docker network — not localhost.
NEXT_PUBLIC_API_URL=http://backend:1323/api
API_V1_PREFIX=/api/v1
BACKEND_PORT=1323
FRONTEND_PORT=3000
DESIGN_PORT=8080

# Gateway (nginx-ui in dev; nginx:alpine in prod overlay)
NGINX_PORT=80
NGINX_UI_PORT=9000
# Prod overlay: migrate on API start (single-instance only)
AUTO_MIGRATE=true

# MinIO (S3-compatible object storage for system_file uploads)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=warehouse-files
S3_REGION=us-east-1
S3_USE_SSL=false
# Browser-facing base for object URLs (API appends /{S3_BUCKET}/{key}).
# Local/dev: host-mapped MinIO API port. Prod behind HTTPS domain: use the public origin
# (nginx.prod.conf proxies /warehouse-files/ → minio) — never http://IP:9002 on an https site.
S3_PUBLIC_BASE_URL=http://localhost:9002

# Dev admin (profile: dev)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
REDIS_COMMANDER_PORT=8081
