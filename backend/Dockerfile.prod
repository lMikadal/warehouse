# Production multi-stage build (used by infrastructure compose).
FROM golang:1.27-bookworm AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/api ./cmd/server
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/seed ./cmd/seed

FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /
COPY --from=build /out/api /api
COPY --from=build /out/seed /seed
COPY --from=build /src/internal/infra/postgres/migrations /internal/infra/postgres/migrations
COPY --from=build /src/internal/infra/postgres/seeds /internal/infra/postgres/seeds

EXPOSE 1323
USER nonroot:nonroot

ENTRYPOINT ["/api"]
