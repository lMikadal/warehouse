PORT=1323
APP_ENV=development
# LOG_LEVEL=debug|info|warn|error (default info); JSON logs when APP_ENV=production
# AUTO_MIGRATE=true|false — empty: migrate on start only when APP_ENV=development
DATABASE_URL=postgres://warehouse:warehouse@localhost:5432/warehouse?sslmode=disable
# REDIS_URL=redis://localhost:6379/0
DEFAULT_LOCALE=th
# Dev-only: use a long random string in production (never commit real .env)
JWT_SECRET=change-me-dev-jwt-secret-min-32-chars
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=168h
# Demo passwords after make backend-seed-test: admin / staff (see document/knowledge/backend.md)
