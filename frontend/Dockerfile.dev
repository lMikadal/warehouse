# Dev image for infrastructure compose (Next.js hot reload via bun).
FROM oven/bun:1

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

EXPOSE 3000

# sh -c: bind-mount over /app must not rely on +x on docker-entrypoint.dev.sh
CMD ["/bin/sh", "-c", "bun install --frozen-lockfile && exec bun run dev -- -H 0.0.0.0"]
