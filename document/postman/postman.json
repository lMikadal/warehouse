{
  "info": {
    "name": "Warehouse API",
    "description": "Warehouse backend API collection for handoff/import.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:1323/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "var j = pm.response.json();",
                  "if (j.access_token) pm.collectionVariables.set('accessToken', j.access_token);",
                  "if (j.refresh_token) pm.collectionVariables.set('refreshToken', j.refresh_token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Permissions (UI codes)",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/permissions" }
        },
        {
          "name": "Nav (sidebar + landing)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept-Language", "value": "th" }],
            "url": "{{baseUrl}}/auth/nav"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "var j = pm.response.json();",
                  "pm.test('has tree', () => pm.expect(j.tree).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Menus",
          "item": [
            {
              "name": "List menus",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept-Language", "value": "th" }],
                "url": {
                  "raw": "{{baseUrl}}/system/menus?page=1&limit=10&search=&is_active=&sort=&order=",
                  "host": ["{{baseUrl}}"],
                  "path": ["system", "menus"],
                  "query": [
                    { "key": "page", "value": "1", "description": "1-based page" },
                    { "key": "limit", "value": "10", "description": "10|25|50|100" },
                    {
                      "key": "search",
                      "value": "",
                      "description": "Optional; matches name (th/en), module, path; tree keeps ancestors"
                    },
                    {
                      "key": "is_active",
                      "value": "",
                      "description": "Optional true|false; tree keeps ancestors"
                    },
                    {
                      "key": "sort",
                      "value": "",
                      "description": "Optional with order: label|module|path|is_active|updated_at"
                    },
                    {
                      "key": "order",
                      "value": "",
                      "description": "asc|desc when sort is set"
                    }
                  ]
                }
              }
            },
            {
              "name": "Permission matrix (role form)",
              "request": {
                "method": "GET",
                "header": [{ "key": "Accept-Language", "value": "th" }],
                "url": "{{baseUrl}}/system/menus/permission-matrix"
              }
            },
            {
              "name": "Create menu",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"module\": \"demo\",\n  \"path\": \"pages/demo.html\",\n  \"is_active\": true,\n  \"names\": { \"th\": \"ทดสอบ\", \"en\": \"Demo\" }\n}"
                },
                "url": "{{baseUrl}}/system/menus"
              }
            },
            {
              "name": "Get menu by id",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{baseUrl}}/system/menus/1"
              }
            },
            {
              "name": "Patch menu",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"is_active\": true,\n  \"names\": { \"th\": \"ทดสอบ\", \"en\": \"Demo\" }\n}"
                },
                "url": "{{baseUrl}}/system/menus/1"
              }
            },
            {
              "name": "Move menu",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"drag_id\": 2,\n  \"target_id\": 1,\n  \"zone\": \"after\"\n}"
                },
                "url": "{{baseUrl}}/system/menus/move"
              }
            }
          ]
        },
        {
          "name": "Permissions",
          "item": [
            {
              "name": "List permissions",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/system/permissions?page=1&limit=25&module=system&type=system_menu&action=view&is_active=true&sort=code&order=asc"
              }
            },
            {
              "name": "Permission list filters",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/system/permissions/filters?module=system"
              }
            },
            {
              "name": "Patch permission active",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"is_active\": true\n}" },
                "url": "{{baseUrl}}/system/permissions/1"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Roles",
          "item": [
            {
              "name": "List roles",
              "request": { "method": "GET", "url": "{{baseUrl}}/admin/roles?page=1&limit=10" }
            },
            {
              "name": "Get role",
              "request": { "method": "GET", "url": "{{baseUrl}}/admin/roles/1" }
            },
            {
              "name": "Create role",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"is_active\": true,\n  \"names\": { \"th\": \"บทบาทใหม่\", \"en\": \"New role\" },\n  \"permission_ids\": [1, 2, 3]\n}"
                },
                "url": "{{baseUrl}}/admin/roles"
              }
            },
            {
              "name": "Patch role is_active",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"is_active\": false\n}"
                },
                "url": "{{baseUrl}}/admin/roles/2"
              }
            }
          ]
        },
        {
          "name": "Users",
          "item": [
            {
              "name": "List users",
              "request": { "method": "GET", "url": "{{baseUrl}}/admin/users?page=1&limit=10" }
            },
            {
              "name": "User filters (roles lookup)",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/admin/users/filters?page=1&limit=100&search="
              }
            },
            {
              "name": "Get user",
              "request": { "method": "GET", "url": "{{baseUrl}}/admin/users/1" }
            },
            {
              "name": "Create user",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"demo_user\",\n  \"password\": \"ChangeMe123\",\n  \"admin_role_id\": 2,\n  \"type\": \"staff\",\n  \"status\": \"active\"\n}"
                },
                "url": "{{baseUrl}}/admin/users"
              }
            },
            {
              "name": "Patch user",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"active\",\n  \"password_credit\": \"8888\",\n  \"password_discount\": \"9999\"\n}"
                },
                "url": "{{baseUrl}}/admin/users/1"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Website",
      "item": [
        {
          "name": "Languages",
          "item": [
            {
              "name": "List languages",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/system/languages?page=1&limit=10&is_active=true"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('status 200', () => pm.response.to.have.status(200));"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Get language",
              "request": { "method": "GET", "url": "{{baseUrl}}/system/languages/1" }
            },
            {
              "name": "Create language",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"locale\": \"ja\",\n  \"name\": \"日本語\",\n  \"is_active\": true,\n  \"is_default\": false\n}"
                },
                "url": "{{baseUrl}}/system/languages"
              }
            },
            {
              "name": "Patch language is_active",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"is_active\": false\n}" },
                "url": "{{baseUrl}}/system/languages/2"
              }
            },
            {
              "name": "Patch language is_default",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"is_default\": true\n}" },
                "url": "{{baseUrl}}/system/languages/2"
              }
            },
            {
              "name": "Reorder languages",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"drag_id\": 2,\n  \"target_id\": 1\n}"
                },
                "url": "{{baseUrl}}/system/languages/reorder"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('status 204', () => pm.response.to.have.status(204));"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Delete language",
              "request": { "method": "DELETE", "url": "{{baseUrl}}/system/languages/99" }
            }
          ]
        },
        {
          "name": "Countries",
          "item": [
            {
              "name": "List countries",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/system/countries?page=1&limit=10"
