{
  "info": {
    "name": "Warehouse API",
    "description": "Warehouse backend API collection for handoff/import.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:1323/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('body status is ok', function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Liveness probe — no auth. Versioned under /api/v1."
          },
          "response": []
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Menus",
          "item": [
            {
              "name": "List menus",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', function () {",
                      "  pm.response.to.have.status(200);",
                      "});",
                      "pm.test('has items and meta', function () {",
                      "  var json = pm.response.json();",
                      "  pm.expect(json.items).to.be.an('array');",
                      "  pm.expect(json.meta).to.have.property('total');",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept-Language",
                    "value": "th"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/system/menus?page=1&limit=10",
                  "host": ["{{baseUrl}}"],
                  "path": ["system", "menus"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "10" }
                  ]
                },
                "description": "Paginated system menu list (tree order). Requires migrated DB + optional test seed."
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Users, roles, sessions — endpoints added as modules ship.",
      "item": []
    },
    {
      "name": "Auth",
      "description": "Login and token refresh — endpoints added with auth module.",
      "item": []
    }
  ]
}
